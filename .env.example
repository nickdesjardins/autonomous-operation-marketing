# Copy to .env (or .env.local, which overrides .env) and fill in what you have. Every value has
# a sane default in app/config.py; blank means "unset". Never commit either file.

# ---------------------------------------------------------------- application
SERVICE_NAME=multi-agent-ops-pipeline
# development | test | production (production hides /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional inbound shared secret for THIS service (header X-API-Key). Outside demo mode it
# protects every /api/v1/workflows route. Not a provider key.
API_KEY=
# Origins allowed to call the API from a browser, comma-separated (the GitHub Pages site).
# Empty = no CORS headers; * = any origin.
CORS_ALLOW_ORIGINS=
PLAYGROUND_ENABLED=true
MAX_JSON_BODY_BYTES=32768

# ------------------------------------------------------------------- database
# postgres (default): checkpoints and inventory in PostgreSQL.
# memory: no database at all, every thread forgotten at restart (a first look on a laptop).
CHECKPOINTER=postgres
# Matches docker-compose.yml. Hosted Postgres (Neon, Render): paste the provider's string as
# it is, sslmode and channel_binding included.
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops
# Neon's direct (non-pooler) string, as Vercel/Neon name it. Preferred over DATABASE_URL when
# both are set: the app runs its own connection pool.
DATABASE_URL_UNPOOLED=
POSTGRES_DB=ops
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_S=10
# Retries of the start-up schema check while a serverless database (Neon) resumes.
DB_STARTUP_RETRIES=3
HEALTH_TIMEOUT_S=5
# Create the inventory tables, upsert the sample SKUs, set up the checkpoint tables.
AUTO_CREATE_SCHEMA=true

# ------------------------------------------------------------------- pipeline
# Self-correction loops allowed when a request does not name a number (0 to 5).
MAX_REVISIONS=3
SYNTHESIS_TEMPERATURE=0.2
AUDIT_TEMPERATURE=0.0
# Output caps. Models that reason before answering spend part of the budget on that:
# liquid/lfm-2.5-2.6b cannot switch reasoning off and thinks for about 2000 tokens.
SYNTHESIS_MAX_TOKENS=4096
AUDIT_MAX_TOKENS=4096

# ------------------------------------------------------------------ providers
# openrouter (default, free models) | openai_compatible | anthropic
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys. Free model endpoints may keep and train on what
# they are sent: use the sample SKUs, not real product dossiers.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered, comma-separated chain. Leave BLANK to let the service look after the chain itself:
# it starts from the tested default in app/config.py, reads the chain this project's scheduled
# test published (one small file on GitHub, no key), and when a model is withdrawn it tests
# the free models on offer with its own two tasks and gives the free place to one that passes.
# Name models here to pin the chain: the service then calls exactly those and never tests or
# replaces one. Every id must end in ":free" while OPENROUTER_FREE_ONLY=true.
OPENROUTER_MODELS=
OPENROUTER_FREE_ONLY=true
# true = strict json_schema first; a model that rejects it is retried in plain JSON mode.
OPENROUTER_STRICT_JSON_SCHEMA=true
# OpenRouter allows 20 requests/min on free models, and 50/day without credits (1000/day after
# a one-time $10 credit purchase). Request starts are paced to this value; 0 = no pacing.
OPENROUTER_REQUESTS_PER_MINUTE=20
OPENROUTER_TIMEOUT_S=60
# Reasoning control sent to every model of the chain (OpenRouter's unified parameter):
# default (send nothing) | off | minimal | low | medium | high. Models that think before they
# answer spend the output budget on that and can run out of it before the JSON: measured on
# 15 October 2026, nvidia/nemotron-3-super-120b-a12b answered in 13 s with reasoning off, in
# 83 s with low, and not at all (truncated) with reasoning left to its default. A model whose
# endpoint refuses the switch (liquid/lfm-2.5-2.6b) is called without it.
OPENROUTER_REASONING=off
# null = never read the published chain; leave the line out to read this project's own.
# MODEL_PUBLISHED_URL=null
# false = no request at startup (offline work); the published chain is read after the first
# request that fails.
MODEL_CATALOGUE_CHECK=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=multi-agent-ops-pipeline

# Any OpenAI-compatible Chat Completions endpoint (LLM_PROVIDER=openai_compatible): OpenAI,
# Gemini (https://generativelanguage.googleapis.com/v1beta/openai), Groq.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Claude through the official SDK (LLM_PROVIDER=anthropic). Claude 5.x models take no
# temperature; ANTHROPIC_EFFORT (low to max) is the lever.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# -------------------------------------------------------------------- webhook
# url: POST to WEBHOOK_URL. self: POST to this service's own HMAC-verified receiver at
# PUBLIC_BASE_URL/api/v1/webhooks/receiver (the public demo). dry_run: record the delivery and
# send nothing, signed when WEBHOOK_SECRET is set and marked "unsigned" otherwise (the default,
# so a fresh checkout never calls out).
WEBHOOK_TARGET=dry_run
WEBHOOK_URL=
# HMAC-SHA256 key for the X-Signature-256 header. Required for url and self. Any long random
# string: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=3
# This service's own public address, for WEBHOOK_TARGET=self (Render fills RENDER_EXTERNAL_URL
# by itself; set this one for other hosts or for a local run: http://127.0.0.1:8000).
PUBLIC_BASE_URL=

# ----------------------------------------------------- public showcase (demo mode)
# true = runs are open to visitors but budgeted, max_revisions is capped, and the webhook can
# only reach this service's own receiver. render.yaml sets this for the deployed demo.
DEMO_MODE=false
DEMO_MAX_REVISIONS=2
# Visitor addresses, for the per-visitor limits. Leave TRUST_PROXY_HEADERS=false when clients
# reach the app directly (they could forge the headers). Behind a reverse proxy, set it to
# true and name the header the edge overwrites (CF-Connecting-IP behind Cloudflare, as on
# Render); otherwise the X-Forwarded-For entry TRUSTED_PROXY_HOPS places from the right is used.
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
# Demo-mode limits: runs per visitor per minute and per UTC day, for everyone per minute and
# per UTC day, and runs executed at once. One run is up to 2 * max(1, max_revisions) model
# calls; the budget reserves 2 * (max_revisions + 1), one attempt more than can happen.
RUN_RATE_LIMIT_PER_MINUTE=2
RUN_DAILY_LIMIT_PER_CLIENT=12
RUN_GLOBAL_LIMIT_PER_MINUTE=6
RUN_DAILY_LIMIT=120
RUN_MAX_INFLIGHT=2
# Ask OpenRouter (GET /key) how many free requests are left today, at most once a minute, and
# stop admitting public runs when fewer than the reserve remain.
OPENROUTER_ALLOWANCE_CHECK=true
OPENROUTER_ALLOWANCE_RESERVE=100

# ------------------------------------------------ hosted database (Neon, also via Vercel)
# Neon's dashboard (or Vercel's "Storage" tab) offers a block of lines. Paste the two that this
# service reads into .env.local (never into this file):
#   DATABASE_URL=postgresql://...-pooler...neon.tech/neondb?sslmode=require&channel_binding=require
#   DATABASE_URL_UNPOOLED=postgresql://...neon.tech/neondb?sslmode=require
# The app uses the unpooled one when both are present (it runs its own connection pool). The
# other names in that block (PGHOST, PGUSER, PGPASSWORD, POSTGRES_URL, POSTGRES_PRISMA_URL and
# so on) are not read by this project and can be left out.
